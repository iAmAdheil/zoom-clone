# Copy this file to .env. Never commit real values.
# development or production. In production the server refuses to start with the default JWT_SECRET.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./zoomclone.db
# Use a long random string. Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Leave the Google values empty to disable Google sign-in. The Google routes then return 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The frontend origin. Used for CORS, the invite link and the Google callback URL.
FRONTEND_ORIGIN=http://localhost:3000
# Set to true to allow POST /api/auth/demo.
ENABLE_DEMO_LOGIN=true
