# Copy this file to .env. Never commit real values.
# development or production. In production the server refuses to start with the default JWT_SECRET.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./zoomclone.db
# Use a long random string. Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Leave the Google values empty to disable Google sign-in. The Google routes then return 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The frontend origin. Used for CORS, the invite link and the Google callback URL.
FRONTEND_ORIGIN=http://localhost:3000
# Set to true to allow POST /api/auth/demo.
ENABLE_DEMO_LOGIN=true
# Optional tuning (defaults shown). See backend/README.md.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEMO_PER_MINUTE=30
# RATE_LIMIT_JOIN_PER_MINUTE=60
# RATE_LIMIT_PASSCODE_FAILURES=10
# RATE_LIMIT_PASSCODE_WINDOW_SECONDS=300
# TRUST_FORWARDED_FOR=true
# MAX_BODY_BYTES=65536
# MAX_SOCKETS_PER_PARTICIPANT=3
# PRESENCE_GRACE_SECONDS=60
# REAPER_INTERVAL_SECONDS=15
# IDLE_MEETING_MINUTES=10
# MAX_MEETING_HOURS=24
# DB_BUSY_TIMEOUT_MS=5000
# WS_DB_THREADS=20
