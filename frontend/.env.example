# Copy this file to .env.local. Never commit real values.

# The FastAPI backend. Next.js forwards every /api/* request to this URL.
# Next.js reads it at build time and at start time. Rebuild after you change it.
BACKEND_URL=http://localhost:8000

# The WebSocket base URL for the meeting room. The browser connects to it directly,
# because Vercel cannot forward WebSockets. Next.js puts this value in the bundle at build time.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# WebRTC ICE servers. The app always uses the public Google STUN server.
# Strict NATs and many company networks need a TURN server. Leave these empty to use STUN only.
# NEXT_PUBLIC_TURN_URL can hold more than one URL, separated by commas.
# Example: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
# These values go into the browser bundle at build time. Use a TURN account with limits.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
